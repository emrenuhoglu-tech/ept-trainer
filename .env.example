# EPT Trainer — ortam degiskenleri
# Faz 1 (Ders + Hizli Referans) HICBIRINI gerektirmez; Web Speech tarayicidan calisir.

# --- Faz 2: Drill Modu (server/proxy.mjs; anahtar istemciye sizmaz) ---
ANTHROPIC_API_KEY=

# Model: her sey icin fable 5, refusal/hata olursa opus'a duser (Emre karari).
ANTHROPIC_MODEL=claude-fable-5
ANTHROPIC_FALLBACK_MODEL=claude-opus-4-8
# Fable 5 thinking hep acik oldugu icin JSON ciktisina yer birak.
ANTHROPIC_MAX_TOKENS=3000

# Proxy portu
PORT=8787

# --- Faz 3: dogal TTS (opsiyonel; yoksa Web Speech'e duser) ---
# Anahtarlar SADECE proxy'de kullanilir. Uygulamada "HD ses" dugmesiyle acilir.
# Saglayici: web | openai | elevenlabs  (varsayilan: web)
TTS_PROVIDER=openai

# OpenAI TTS (Emre tercihi: yeni surum cok iyi)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ElevenLabs (alternatif)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
